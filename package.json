{
  "name": "project---homestay",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:migrate": "dotenv -e .env -- npx sequelize-cli db:migrate",
    "db:seed": "dotenv -e .env -- npx sequelize-cli db:seed:all",
    "db:backup": "dotenv -e .env -- npx supabase db dump -f supabase_backup.sql",
    "db:download": "dotenv -e .env -- npx supabase db pull"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "nodemon": "^1.14.10",
    "sequelize-cli": "^6.6.5"
  }
}